#!/usr/bin/env bash
# Installs resmon as a launchable desktop app: a `resmon` command on PATH,
# an app-menu entry with icon, both pointing back at this checkout.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin_dir="$HOME/.local/bin"
apps_dir="$HOME/.local/share/applications"
icons_dir="$HOME/.local/share/icons/hicolor/scalable/apps"

mkdir -p "$bin_dir" "$apps_dir" "$icons_dir"

ln -sf "$here/bin/resmon" "$bin_dir/resmon"
cp "$here/data/icons/dev.local.Resmon.svg" "$icons_dir/dev.local.Resmon.svg"

cat > "$apps_dir/dev.local.Resmon.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Resource Monitor
Comment=A clean, minimal system resource monitor
Exec=$bin_dir/resmon
Icon=dev.local.Resmon
Terminal=false
Categories=Utility;
StartupWMClass=dev.local.Resmon
EOF

cat > "$apps_dir/dev.local.Resmon.Overlay.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Resource Monitor Overlay
Comment=Docks the resource monitor widget to a screen corner
Exec=$bin_dir/resmon --overlay
Icon=dev.local.Resmon
Terminal=false
Categories=Utility;
StartupWMClass=dev.local.Resmon.Overlay
EOF

command -v update-desktop-database >/dev/null && update-desktop-database "$apps_dir" || true
command -v gtk4-update-icon-cache >/dev/null && gtk4-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true

echo "Installed: $bin_dir/resmon"
echo "Launchers: $apps_dir/dev.local.Resmon.desktop"
echo "           $apps_dir/dev.local.Resmon.Overlay.desktop"
echo "Icon:      $icons_dir/dev.local.Resmon.svg"
echo
echo "Search for \"Resource Monitor\" (full app) or \"Resource Monitor Overlay\" (widget) in your app launcher."
echo "Or from a terminal: resmon / resmon --overlay"
