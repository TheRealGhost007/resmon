#!/usr/bin/env python3
"""Adds resmon as a `command`-type module to Omarchy's bar, in shell.json's
bar.layout.right — idempotent, and touches nothing else in the file.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

SHELL_JSON = Path.home() / ".config" / "omarchy" / "shell.json"
MODULE_ID = "resmon"
MODULE = {
    "id": MODULE_ID,
    "type": "command",
    "exec": "~/.local/bin/resmon --bar-module",
    "interval": 3,
}


def main() -> None:
    if not SHELL_JSON.exists():
        print(f"No {SHELL_JSON} found — skipping. Customize the bar once in Omarchy first, then re-run this.")
        sys.exit(1)

    config = json.loads(SHELL_JSON.read_text())
    layout = config.setdefault("bar", {}).setdefault("layout", {})

    for section in layout.values():
        if any(isinstance(entry, dict) and entry.get("id") == MODULE_ID for entry in section):
            print("resmon is already in the bar — nothing to do.")
            return

    right = layout.setdefault("right", [])
    right.append(dict(MODULE))

    SHELL_JSON.write_text(json.dumps(config, indent=2) + "\n")
    print(f"Added to {SHELL_JSON} (bar.layout.right).")
    print("Omarchy watches this file and reloads automatically. If it doesn't show up, run: omarchy-restart-shell")


if __name__ == "__main__":
    main()
